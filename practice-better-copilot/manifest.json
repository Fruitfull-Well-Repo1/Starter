{
  "manifest_version": 3,
  "name": "Practice Better Reply Copilot",
  "version": "0.1.0",
  "description": "Drafts client replies in Practice Better using Claude.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.practicebetter.io/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.practicebetter.io/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Practice Better Reply Copilot",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
